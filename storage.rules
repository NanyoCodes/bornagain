rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Resumable Upload Authorization Fix - 2025-04-01T12:00:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      // Supporting up to 100MB for high-fidelity miracle proof (video/photo)
      return request.resource.size < 100 * 1024 * 1024;
    }

    // Global read access to ensure the Body of Christ can witness all shared miracles
    allow read: if true;

    // Granular write access for mission-critical directories with sub-path matching
    match /events/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }

    match /testimonies/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }

    match /campaigns/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }
    
    match /campaign-assets/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }

    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }

    match /vendor-branding/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }

    match /marketplace-items/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) && isValidSize();
    }

    // Generic fallback for any other mission-critical uploads
    match /{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isValidSize();
    }
  }
}