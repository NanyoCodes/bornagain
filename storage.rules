rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Explicit Hub Access (Meals & Kindness) - 2025-09-02T16:00:00Z
    
    // Allow public read access for all ministry assets, testimonies, and profile photos
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Explicit matches for ministry hubs to ensure maximum reliability 
     * across all workstation and workstation proxy environments.
     */
    match /profile-pictures/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /meals-center/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /kindness-center/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /vendor-items/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    /**
     * Authenticated Write Policy
     * Grants users write access to their own UID-named folders across any top-level category.
     */
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    /**
     * Fallback Pattern: /userId/file.jpg
     */
    match /{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}