
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Fresh Token Verification & UID Authorization - 2025-07-04T19:45:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType /.*') ||
             request.resource.contentType == 'application/pdf';
    }

    function isAllowedFolder(folder) {
      return folder in ['profile-pictures', 'vendor-branding', 'meals-center', 'kindness-center', 'campaign-assets', 'testimonies', 'souls'];
    }

    match /{allPaths=**} {
      allow read: if true;
    }

    // Secure UID-based directory structure for all Kingdom assets
    // Validates: {folder}/{userId}/{filename}
    // recursive wildcard ensures all nested files in user's folder are covered
    match /{folder}/{userId}/{allPaths=**} {
      allow create, update: if isOwner(userId) && isAllowedFolder(folder) && isValidSize() && isAllowedType();
      allow delete: if isOwner(userId);
    }
  }
}
