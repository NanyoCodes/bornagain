rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Synchronized Authorization for Kingdom Assets - 2025-06-27T09:00:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules ensure users can only write to their own designated subdirectories.
     * Path structure: {folder}/{userId}/{filename}
     */
    
    // Matches categorized paths: /{folder}/{userId}/{allPaths=**}
    // Covers: vendor-branding, profile-pictures, meals-center, kindness-center.
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Matches root user paths for legacy or direct uploads
    match /{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
