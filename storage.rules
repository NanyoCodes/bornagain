rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Immediate authorized access for all mission folders including territories - 2025-03-12T21:00:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB limit
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    function isAllowedFolder(folder) {
      return folder in [
        'profile-pictures', 
        'vendor-branding', 
        'marketplace-items',
        'meals-center', 
        'kindness-center', 
        'campaign-assets', 
        'testimonies', 
        'souls', 
        'events', 
        'territories'
      ];
    }

    // Unified rule for UID-based directory structure
    match /{folder}/{userId}/{allPaths=**} {
      // Public Read for public-facing assets
      allow read: if folder in [
        'profile-pictures', 
        'vendor-branding', 
        'marketplace-items',
        'meals-center', 
        'kindness-center', 
        'campaign-assets', 
        'testimonies', 
        'events', 
        'territories'
      ];
      
      // Private Read for souls data
      allow read: if folder == 'souls' && isAuthenticated();

      // Secure Write access for owners
      allow create, update: if isOwner(userId) && isAllowedFolder(folder) && isValidSize() && isAllowedType();
      allow delete: if isOwner(userId);
    }
  }
}