rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Professional Kingdom Storage Authorization - 2025-07-10T10:00:00Z
    
    /**
     * Shared Helper Functions
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSmallFile() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    /**
     * Global Read Access
     * Shared ministry assets, profile photos, and marketplace items are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Primary Kingdom Asset Path (v1)
     * Secure, validated uploads organized by User ID.
     * Path structure: testify-v1/users/{userId}/{folder}/{filename}
     */
    match /testify-v1/users/{userId}/{folder}/{filename} {
      allow create, update: if isOwner(userId) && isImage() && isSmallFile();
      allow delete: if isOwner(userId);
    }

    /**
     * Legacy & Migration Paths
     * Preserving access for older records while enforcing size limits.
     */
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isSmallFile();
    }
    
    match /{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isSmallFile();
    }
  }
}