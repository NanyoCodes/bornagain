
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Critical Access Refinement - 2025-09-02T10:00:00Z
    
    // Allow public read access for all ministry assets, testimonies, and profile photos
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated Write Policy
     * Explicitly grants users write access to their own UID-named folders.
     * matches: /vendor-items/USER_ID/filename.jpg, /profile-pictures/USER_ID/photo.jpg, etc.
     */
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    /**
     * Fallback for deeper structures
     */
    match /{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
