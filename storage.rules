rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Enhanced Authorization for Ministry Hub Assets - 2025-06-26T10:00:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules ensure users can only write to their own designated subdirectories.
     * Path structure: {storagePath}/{userId}/{filename}
     */
    
    // Matches categorized paths: /{folder}/{uid}/{allPaths=**}
    // Covers: vendor-branding, profile-pictures, meals-center, kindness-center.
    match /{folder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Matches root user paths for legacy or direct uploads
    match /{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
