rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Explicitly authorized 'regions hub' path for territorial evidence - 2025-03-25T09:00:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    function isAllowedType() {
      return request.resource.contentType.startsWith('image/') || 
             request.resource.contentType.startsWith('video/') ||
             request.resource.contentType.startsWith('audio/') ||
             request.resource.contentType == 'application/pdf';
    }

    // Specific policy for Regions Hub (Territories)
    match /regions hub/{userId}/{allPaths=**} {
      // Public read for global visibility of territorial challenges
      allow read: if true;
      
      // Strict owner-only write/delete
      allow write: if isOwner(userId) && isValidSize() && (request.resource == null || isAllowedType());
      allow delete: if isOwner(userId);
    }

    // Unified policy for other user-partitioned mission folders (testimonies, campaigns, etc.)
    match /{folder}/{userId}/{allPaths=**} {
      // Public read for global visibility of God's work
      allow read: if true;
      
      // Strict owner-only write/delete
      allow write: if isOwner(userId) && isValidSize() && (request.resource == null || isAllowedType());
      allow delete: if isOwner(userId);
    }

    // Global fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize() && (request.resource == null || isAllowedType());
    }
  }
}
