
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read for all files, which is useful for displaying images.
    match /{allPaths=**} {
      allow read;
    }

    // Allow users to upload their own testimony images.
    match /testimonies/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to upload their own campaign images.
    match /campaigns/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to upload media to chats they are a part of.
    match /chat_media/{chatId}/{fileName} {
      allow write: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
    }
  }
}
