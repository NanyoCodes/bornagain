rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Emergency Fix for Access Denied - 2025-09-02T18:00:00Z
    
    // Allow public read access for all ministry assets, testimonies, and profile photos
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Universal Authenticated Write Policy
     * Grants users write access to their own UID-named folders across any top-level category.
     * This covers /meals-center/, /kindness-center/, /profile-pictures/, etc.
     */
    match /{folder}/{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    /**
     * Fallback Pattern for top-level UID folders: /userId/file.jpg
     */
    match /{userId}/{allPaths=**} {
       allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}