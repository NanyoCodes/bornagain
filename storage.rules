rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Explicit Territory and Mission Evidence pathway - 2025-03-12T23:00:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB limit
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Explicit pathway for mission evidence and territory reports
    match /territories/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidSize() && isAllowedType();
      allow delete: if isOwner(userId);
    }

    // Unified policy for other mission-critical folders
    match /{folder}/{userId}/{allPaths=**} {
      allow read: if folder in [
        'profile-pictures', 
        'vendor-branding', 
        'marketplace-items',
        'meals-center', 
        'kindness-center', 
        'campaign-assets', 
        'testimonies', 
        'events'
      ];
      
      allow read: if folder == 'souls' && isAuthenticated();

      allow write: if isOwner(userId) && (
        folder in [
          'profile-pictures', 
          'vendor-branding', 
          'marketplace-items',
          'meals-center', 
          'kindness-center', 
          'campaign-assets', 
          'testimonies', 
          'souls', 
          'events'
        ]
      ) && isValidSize() && isAllowedType();

      allow delete: if isOwner(userId);
    }
  }
}