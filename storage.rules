rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Emergency Fix for Access Denied - 2025-09-02T20:00:00Z
    
    // Global public read access for all ministry assets
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Explicit Folder Authorizations
     * These rules definitively grant write access to authenticated users for their unique directories.
     */
    
    match /profile-pictures/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /meals-center/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /kindness-center/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /vendor-items/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /testimony-media/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Fallback for top-level UID directories
    match /{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Generic catch-all for nested folders
    match /{folder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}