rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // WARNING: This is a temporary, permissive rule for debugging.
    // It allows any authenticated user to read or write any file.
    // This is not secure for a production environment.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
