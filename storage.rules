rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Integrated Production Bucket & Comprehensive Folder Rules - 2025-06-25T14:30:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * Grants write access to the specific bucket: studio-6220967431-56fe2.firebasestorage.app
     * only for authenticated users operating on their unique subdirectories.
     */
    
    // Authorization for categorized folders (profile-pictures, vendor-branding, center-specific items)
    match /{folder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Authorization for direct root user directories
    match /{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
