rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Updated for Kingdom Worship music metadata - 2025-03-05T16:00:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    function isAllowedFolder(folder) {
      return folder in ['profile-pictures', 'vendor-branding', 'meals-center', 'kindness-center', 'campaign-assets', 'testimonies', 'souls', 'events'];
    }

    // Publicly viewable Kingdom activities (Identities and Testimonies)
    match /{folder}/{userId}/{allPaths=**} {
      allow read: if folder in ['profile-pictures', 'vendor-branding', 'meals-center', 'kindness-center', 'campaign-assets', 'testimonies', 'events'];
    }

    // Private harvest records (Converted souls information)
    match /souls/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
    }

    // Secure UID-based directory structure for all Kingdom assets
    // Validates: {folder}/{userId}/{filename}
    match /{folder}/{userId}/{allPaths=**} {
      allow create, update: if isOwner(userId) && isAllowedFolder(folder) && isValidSize() && isAllowedType();
      allow delete: if isOwner(userId);
    }
  }
}