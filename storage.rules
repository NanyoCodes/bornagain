rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all miracle evidence and profile photos for the community feed
    match /{allPaths=**} {
      allow read: if true;
    }

    // Explicitly grant write permissions to authenticated owners for their respective folders
    // We use a specific match for the userId to ensure rules are applied correctly
    match /profile-pictures/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /testimony-media/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /vendor-items/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}