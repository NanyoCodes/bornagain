rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function for user ownership
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /profile-pictures/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid);
    }
    
    match /testimony-images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid);
    }
    
    // Optimized permissions for the souls-won directory
    match /souls-won/{uid}/{allPaths=**} {
      // Allow any authenticated user to view soul photos for collaborative discipleship
      allow read: if request.auth != null;
      
      // Allow only the original soul winner to manage the images
      allow write: if isOwner(uid);
    }
  }
}