rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function for user ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    match /testimony-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    // Explicitly handle permissions for the souls-won directory
    match /souls-won/{userId}/{allPaths=**} {
      // Allow any authenticated user to view soul photos for collaborative discipleship
      allow read: if request.auth != null;
      
      // Allow only the original winner (owner of the directory) to upload or modify photos
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}