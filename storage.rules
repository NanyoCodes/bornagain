rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Universal public read and strict owner write for all mission folders - 2025-03-18T23:45:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB limit
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Unified policy for user-partitioned folders
    // Pattern: {folder}/{userId}/{filename}
    match /{folder}/{userId}/{allPaths=**} {
      // Allow public read for all folders to ensure global visibility of God's work
      allow read: if true;
      
      // Allow write and delete only if the user is the owner of the directory
      allow write: if isOwner(userId) && isValidSize() && (request.resource == null || isAllowedType());
      allow delete: if isOwner(userId);
    }

    // Fallback for non-partitioned or root paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize() && (request.resource == null || isAllowedType());
    }
  }
}