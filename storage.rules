rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Granting explicit permission for vendor branding - 2025-06-26T12:00:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules ensure users can only write to their own designated subdirectories.
     */
    
    // Explicit rule for vendor branding
    match /vendor-branding/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Matches other categorized paths: /{folder}/{userId}/{file}
    // e.g., profile-pictures/UID/photo.jpg
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Matches root user paths: /{userId}/{file}
    match /{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
