rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Enhanced security for events and mission-critical folders - 2025-03-25T14:30:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    function isAllowedType() {
      return request.resource.contentType.startsWith('image/') || 
             request.resource.contentType.startsWith('video/') ||
             request.resource.contentType.startsWith('audio/') ||
             request.resource.contentType == 'application/pdf';
    }

    // High-fidelity matching for user-partitioned mission folders
    // This covers 'events', 'testimonies', 'campaigns', 'profile-pictures', 'marketplace-items' etc.
    match /{folder}/{userId}/{allPaths=**} {
      // Public read for global visibility of God's work
      allow read: if true;
      
      // Strict owner-only write/delete
      // Note: request.resource == null handles deletions in some SDK versions
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    // Specific policy for 'regions hub' to handle the space character explicitly
    match /regions hub/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    // Global fallback for any other files
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize();
    }
  }
}