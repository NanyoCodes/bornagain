rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Reinforced access for storefront and profile media - 2025-08-28T12:30:00Z
    
    // Allow public read access to all miracle evidence and profile photos for the community feed
    match /{allPaths=**} {
      allow read: if true;
    }

    // Explicitly grant write permissions to authenticated owners for their respective folders
    // Using {uid} wildcard to correctly match the sub-directory and authorize the specific owner
    match /profile-pictures/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    match /testimony-media/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /vendor-items/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
