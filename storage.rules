rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile pictures: Publicly readable, owner-writable
    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Testimony media: Publicly readable, owner-writable
    match /testimony-media/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}