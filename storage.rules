
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile pictures are publicly readable.
    // Users can only write/update/delete their own profile picture,
    // and the file must be an image and less than 5MB.
    match /profile-pictures/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Testimony images are publicly readable.
    // Authenticated users can upload images for their testimonies.
    // The path contains the user's ID to enforce ownership.
    match /testimony-images/{userId}/{fileName} {
        allow read;
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
    }
  }
}
