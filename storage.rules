rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Marketplace & Global Assets Sync - 2025-08-29T10:00:00Z
    
    // Allow public read access for all ministry assets, testimonies, and profile photos
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated Write Policy
     * Grants users write access to their own UID-named folders across all top-level categories.
     * folder: profile-pictures, vendor-items, testimony-media, etc.
     */
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Explicit path matches for core ministry features to ensure rule clarity
    match /profile-pictures/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /vendor-items/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /testimony-media/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}