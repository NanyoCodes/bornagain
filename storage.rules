rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Storage Access Refinement - 2025-08-28T14:00:00Z
    
    // Allow public read access to all spiritual evidence and profile photos
    match /{allPaths=**} {
      allow read: if true;
    }

    // Explicitly grant write permissions to authenticated owners for their respective folders
    match /profile-pictures/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /testimony-media/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /vendor-items/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
