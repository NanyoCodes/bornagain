rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Synchronizing Storage Access for Kingdom Assets - 2025-06-25T17:30:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules ensure users can only write to their own designated subdirectories.
     */
    
    // Matches categorized paths: /{folder}/{userId}/{file}
    // e.g., vendor-branding/UID/photo.jpg
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Matches root user paths: /{userId}/{file}
    match /{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
