rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Correcting events directory permissions - 2025-03-26T10:00:00Z
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSize() {
      // Increased to 100MB to support video evidence
      return request.resource.size < 100 * 1024 * 1024;
    }

    // Global read access for mission visibility across the Body of Christ
    allow read: if true;

    // Explicitly handle the 'events' folder for gather evidence
    match /events/{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    // Explicitly handle other mission-critical folders
    match /testimonies/{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    match /campaigns/{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    match /profile-pictures/{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    // Catch-all for any other user-partitioned mission folders
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if isOwner(userId) && isValidSize();
      allow delete: if isOwner(userId);
    }

    // Fallback for root level or other patterns
    match /{allPaths=**} {
      allow write: if isAuthenticated() && isValidSize();
    }
  }
}