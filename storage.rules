
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read for all files.
    match /{allPaths=**} {
      allow read;
    }

    // Disallow user-specific writes as photo upload is removed.
    match /users/{userId}/{allPaths=**} {
      allow write: if false;
    }
  }
}
