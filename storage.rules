rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Hierarchical Authorization for Storefronts & Branding - 2025-02-23T12:30:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules grant write access to authenticated users for directories where the 
     * folder structure contains their unique UID.
     */
    
    // Categorized Folder Pattern
    // Matches: {folder}/{uid}/{filename}
    // Handles: profile-pictures/{uid}/..., vendor-branding/{uid}/..., meals-center/{uid}/..., kindness-center/{uid}/...
    match /{folder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Direct User-Root Pattern
    // Matches: {uid}/{filename}
    match /{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Nested Folder Pattern
    // Matches: {folder}/{subfolder}/{uid}/{allPaths=**}
    match /{folder}/{subfolder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
