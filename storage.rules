rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Universal Storage Authorization for Kingdom Assets - 2025-11-20T15:45:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules grant write access to authenticated users for directories where the 
     * folder structure contains their unique UID.
     */
    
    // Matches: {category}/{uid}/{filename}
    // Used by: profile-pictures, vendor-branding, meals-center, kindness-center, etc.
    match /{folder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Matches: {uid}/{filename} (fallback for direct user-root uploads)
    match /{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Matches: {folder}/{subfolder}/{uid}/{allPaths=**} (nested folder support)
    match /{folder}/{subfolder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}