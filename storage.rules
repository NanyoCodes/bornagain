rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Critical Access Fix for Marketplace & Branding - 2025-06-25T15:45:00Z
    
    /**
     * Global Read Access
     * All shared ministry assets, testimonies, and marketplace photos are publicly readable.
     */
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * Grants write access to the specific bucket: studio-6220967431-56fe2.firebasestorage.app
     * only for authenticated users operating on their unique subdirectories.
     */
    
    // Authorization for categorized folders (profile-pictures, vendor-branding, etc.)
    // Matches path: /{folder}/{userId}/{allPaths=**}
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Authorization for direct root user directories
    // Matches path: /{userId}/{allPaths=**}
    match /{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}