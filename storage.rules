rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Authorization helper: Ensures the user is logged in and matches the path UID
    function canWrite(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profile pictures: Publicly readable for identity verification, owner-writable
    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if canWrite(userId);
    }
    
    // Testimony media: Publicly readable for the miracle feed, owner-writable
    match /testimony-media/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if canWrite(userId);
    }
  }
}