rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Universal Path Sync - 2025-08-31T09:00:00Z
    
    // Allow public read access for all ministry assets, testimonies, and profile photos
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated Write Policy
     * Explicitly grants users write access to their own UID-named folders.
     * folder: profile-pictures, vendor-items, testimony-media, etc.
     */
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
