
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    allow read;

    // Profile pictures: Only the owner can upload/update their profile picture.
    // Files should be reasonably small (e.g., < 2MB).
    match /profile-pictures/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Testimony media: Only authenticated users can upload media.
    // Let's cap file sizes at 5MB as per the create-testimony-form.
    match /testimonies/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*') || 
                        request.resource.contentType.matches('video/.*') ||
                        request.resource.contentType.matches('audio/.*'));
    }

    // Campaign images: Only authenticated users can upload images.
    // Let's also cap file sizes at 5MB.
    match /campaign-images/{userId}/{fileName} {
        allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
