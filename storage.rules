rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function for user ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    match /testimony-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /soul-photos/{userId}/{allPaths=**} {
      // Allow any authenticated user to read soul photos (needed for collaborative follow-up within groups)
      allow read: if request.auth != null;
      // Allow only the owner (the user who logged the soul) to manage these photos
      allow write: if isOwner(userId);
    }
  }
}