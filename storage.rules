rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deployment trigger: Critical fix for Storage Access - 2025-06-15T12:00:00Z
    
    // Global public read access for all ministry assets
    match /{allPaths=**} {
      allow read: if true;
    }

    /**
     * Authenticated User Authorizations
     * These rules grant write access to authenticated users for their unique subdirectories.
     */
    
    // Explicitly allowed folders for user-owned assets
    match /profile-pictures/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /meals-center/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /kindness-center/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /vendor-branding/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /vendor-items/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /testimony-media/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Comprehensive catch-all for any folder-based user directory (e.g. folder/uid/filename)
    match /{folder}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Fallback for top-level UID directories (e.g. uid/filename)
    match /{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}