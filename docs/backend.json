{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "bio": {
          "type": "string",
          "description": "A short user biography."
        },
        "location": {
          "type": "string",
          "description": "The user's general location."
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "coverBannerUrl": {
          "type": "string",
          "format": "uri",
          "description": "A URL for the user's profile cover image."
        }
      },
      "required": [
        "displayName",
        "email"
      ]
    },
    "Testimony": {
      "title": "Testimony",
      "description": "A user's testimony of what God has done.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorAvatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "object"
        },
        "mediaUrl": {
          "type": "string",
          "format": "uri"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio"
          ]
        }
      },
      "required": [
        "content",
        "category",
        "authorId",
        "authorName",
        "createdAt"
      ]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A user-created evangelism campaign.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "participants": {
          "type": "number"
        },
        "progress": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "object"
        },
        "organizerId": {
          "type": "string"
        },
        "organizerName": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "location",
        "createdAt",
        "organizerId",
        "organizerName"
      ]
    },
    "Soul": {
      "title": "Soul",
      "description": "Represents a person led to Christ, tracked by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "Personal",
            "Campaign",
            "Referral"
          ]
        },
        "sourceDetails": {
          "type": "string"
        },
        "wonAt": {
          "type": "object"
        },
        "status": {
          "type": "string"
        },
        "followUpLog": {
          "type": "array"
        },
        "attendingChurch": {
          "type": "boolean"
        },
        "inBibleStudy": {
          "type": "boolean"
        },
        "attendingPrayer": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "name",
        "source",
        "wonAt",
        "status"
      ]
    },
    "JoinedCampaign": {
      "title": "Joined Campaign",
      "description": "A record of a user joining a campaign.",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "campaignId",
        "joinedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "email",
      "google.com",
      "facebook.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/users/{userId}/souls/{soulId}": {
      "schema": {
        "$ref": "#/entities/Soul"
      },
      "description": "Stores souls won by a specific user."
    },
    "/users/{userId}/joinedCampaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/JoinedCampaign"
      },
      "description": "Stores a record of campaigns a user has joined."
    },
    "/testimonies/{testimonyId}": {
      "schema": {
        "$ref": "#/entities/Testimony"
      },
      "description": "Stores user-submitted testimonies."
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Stores user-created campaigns."
    }
  }
}
