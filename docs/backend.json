{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "displayName_lowercase": {
          "type": "string",
          "description": "The user's full display name, lowercased for searching."
        },
        "displayName_tokens": {
          "type": "array",
          "description": "An array of lowercased words from the display name for searching.",
          "items": { "type": "string" }
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "bio": {
          "type": "string",
          "description": "The user's personal testimony."
        },
        "location": {
          "type": "object",
          "description": "The user's location.",
          "properties": {
            "city": { "type": "string", "description": "The user's city." },
            "country": { "type": "string", "description": "The user's country." }
          }
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "dailyDiscipline": {
          "type": "object",
          "description": "Tracks the user's completed daily disciplines for the current day.",
          "properties": {
            "completed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lastUpdated": {
              "type": "object"
            }
          }
        },
        "readingHistory": {
          "type": "array",
          "description": "A log of the user's Bible reading sessions.",
          "items": {
            "type": "object",
            "properties": {
              "book": {
                "type": "string"
              },
              "chapter": {
                "type": "number"
              },
              "readAt": {
                "type": "object"
              }
            },
            "required": [
              "book",
              "chapter",
              "readAt"
            ]
          }
        },
        "prayerLinks": {
          "type": "array",
          "description": "A list of personal prayer links.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ]
          }
        },
        "notificationSettings": {
          "type": "object",
          "description": "User's notification preferences.",
          "properties": {
            "newCampaignsInArea": {
              "type": "boolean",
              "description": "Notify user about new campaigns in their area."
            },
            "weeklyDigest": {
              "type": "boolean",
              "description": "Send a weekly summary of activity."
            }
          }
        },
        "privacySettings": {
          "type": "object",
          "description": "User's privacy preferences.",
          "properties": {
            "profileVisibility": {
              "type": "string",
              "enum": [
                "public",
                "private"
              ],
              "description": "Controls who can see the user's profile."
            },
            "showLocation": {
              "type": "boolean",
              "description": "Allow others to see the user's city and country."
            }
          }
        },
        "accountabilityPartnerId": {
          "type": "string",
          "description": "The UID of the user's accountability partner."
        },
        "accountabilityPartnerName": {
          "type": "string",
          "description": "The display name of the user's accountability partner."
        },
        "lastChurchAttended": {
          "type": "string",
          "description": "The name of the last church the user attended."
        },
        "churchInfo": {
            "type": "object",
            "description": "The user's primary church details.",
            "properties": {
                "name": { "type": "string", "description": "The name of the user's church." },
                "schedule": {
                  "type": "array",
                  "description": "The user's worship schedule, with each item containing a day and time.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "day": { "type": "string" },
                      "time": { "type": "string" }
                    },
                    "required": ["day", "time"]
                  }
                }
            }
        },
        "attendanceHistory": {
            "type": "array",
            "description": "A log of the user's church attendance.",
            "items": {
                "type": "object",
                "properties": {
                    "churchName": { "type": "string" },
                    "attendedAt": { "type": "object" }
                },
                "required": ["churchName", "attendedAt"]
            }
        }
      },
      "required": [
        "displayName",
        "email"
      ]
    },
    "DailyDisciplineLog": {
      "title": "Daily Discipline Log",
      "description": "A record of completed disciplines for a given day. The document ID is the date string 'YYYY-MM-DD'.",
      "type": "object",
      "properties": {
        "completed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "date": { "type": "object" }
      },
      "required": ["completed", "date"]
    },
    "Testimony": {
      "title": "Testimony",
      "description": "A user's testimony of what God has done.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorAvatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "content",
        "category",
        "authorId",
        "authorName",
        "createdAt"
      ]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A user-created evangelism campaign.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "description": "The campaign's address or general location, often autofilled by Google Maps."
        },
        "latitude": {
          "type": "number",
          "description": "The latitude of the campaign's pinned location."
        },
        "longitude": {
          "type": "number",
          "description": "The longitude of the campaign's pinned location."
        },
        "coverageRadius": {
          "type": "number",
          "description": "The radius of the campaign's coverage area in meters."
        },
        "startDate": {
          "type": "object"
        },
        "endDate": {
          "type": "object"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "participants": {
          "type": "number"
        },
        "maxParticipants": {
          "type": "number",
          "description": "The maximum number of participants allowed in the campaign."
        },
        "createdAt": {
          "type": "object"
        },
        "organizerId": {
          "type": "string"
        },
        "organizerName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deleted"
          ],
          "description": "The current status of the campaign."
        },
        "lastUpdateReason": {
          "type": "string",
          "description": "The reason for the last update."
        },
        "deletionReason": {
          "type": "string",
          "description": "The reason for deleting the campaign."
        },
        "deletedAt": {
          "type": "object",
          "description": "Timestamp when the campaign was deleted."
        },
        "scripture": {
          "type": "string",
          "description": "An inspirational scripture for the campaign."
        },
        "scriptureTestimony": {
          "type": "string",
          "description": "The organizer's personal testimony or caption related to the scripture."
        },
        "soulsLogged": {
          "type": "number",
          "description": "The total number of souls logged for this campaign."
        },
        "streamUrl": {
          "type": "string",
          "format": "uri",
          "description": "A URL to a live stream for the campaign (e.g., YouTube Live, Zoom)."
        }
      },
      "required": [
        "title",
        "description",
        "location",
        "startDate",
        "endDate",
        "startTime",
        "endTime",
        "createdAt",
        "organizerId",
        "organizerName"
      ]
    },
    "Soul": {
      "title": "Soul",
      "description": "Represents a person led to Christ, tracked by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
            "type": "string",
            "format": "email",
            "description": "The soul's email address."
        },
        "phone": {
            "type": "string",
            "description": "The soul's phone number."
        },
        "church": {
          "type": "string",
          "description": "The church the soul is attending."
        },
        "source": {
          "type": "string",
          "enum": [
            "Personal",
            "Campaign",
            "Referral"
          ]
        },
        "sourceDetails": {
          "type": "string"
        },
        "campaignId": {
          "type": "string",
          "description": "The ID of the campaign this soul was won through."
        },
        "userLocation": {
          "type": "object",
          "description": "The location of the user who won the soul.",
          "properties": {
            "city": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "locationWon": {
            "type": "string",
            "description": "The location where the soul was won (e.g., street name, event)."
        },
        "wonAt": {
          "type": "object"
        },
        "status": {
          "type": "string"
        },
        "followUpLog": {
          "type": "array"
        },
        "attendingChurch": {
          "type": "boolean"
        },
        "inBibleStudy": {
          "type": "boolean"
        },
        "attendingPrayer": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "name",
        "source",
        "wonAt",
        "status"
      ]
    },
    "JoinedCampaign": {
      "title": "Joined Campaign",
      "description": "A record of a user joining a campaign.",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "campaignId",
        "joinedAt"
      ]
    },
    "CampaignParticipant": {
      "title": "Campaign Participant",
      "description": "Represents a user who has joined a campaign.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "photoURL": {
          "type": "string",
          "format": "uri"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "userId",
        "displayName",
        "joinedAt"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "A chat session, which can be a group chat for a campaign, a private one-on-one chat related to a campaign, or a private chat between accountability partners.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "participantInfo": {
          "type": "object"
        },
        "campaignId": {
          "type": "string",
          "description": "The ID of the campaign this chat is related to, if applicable."
        },
        "campaignTitle": {
          "type": "string",
          "description": "The title of the campaign this chat is related to, if applicable."
        },
        "isGroupChat": {
          "type": "boolean",
          "description": "Indicates if this is a group chat. If false, it's a one-on-one chat."
        },
        "lastUpdatedAt": {
          "type": "object"
        }
      },
      "required": [
        "participantIds",
        "lastUpdatedAt"
      ]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single message within a chat session.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "senderId",
        "createdAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents an in-app notification for a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who should receive the notification."
        },
        "type": {
          "type": "string",
          "enum": ["campaign_join", "new_chat_message", "accountability_nudge", "accountability_request", "request_accepted", "request_declined"]
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "description": "A URL link to the relevant page (e.g., campaign or chat)."
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": ["userId", "type", "title", "message", "isRead", "createdAt"]
    },
    "AccountabilityRequest": {
      "title": "Accountability Request",
      "description": "A request from one user to another to become accountability partners.",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "fromUserPhotoURL": { "type": "string", "format": "uri" },
        "toUserId": { "type": "string" },
        "toUserName": { "type": "string" },
        "toUserPhotoURL": { "type": "string", "format": "uri" },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": { "type": "object" },
        "respondedAt": { "type": "object" },
        "participantIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "A sorted array of the two participants' UIDs."
        }
      },
      "required": ["fromUserId", "fromUserName", "toUserId", "status", "createdAt", "participantIds"]
    },
    "Mail": {
      "title": "Mail",
      "description": "An email to be sent by the Trigger Email extension.",
      "type": "object",
      "properties": {
        "to": {
          "type": "array",
          "description": "A list of email addresses to send the email to.",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string"
            },
            "html": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "to",
        "message"
      ]
    },
    "BibleHighlight": {
      "title": "Bible Highlight",
      "description": "Represents a user's highlight and notes on Bible verses.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "book": { "type": "string" },
        "chapter": { "type": "number" },
        "verses": {
          "type": "array",
          "items": { "type": "number" }
        },
        "color": { "type": "string", "description": "The color of the highlight (e.g., 'yellow', 'blue')." },
        "note": { "type": "string", "description": "The user's personal note on the highlight." },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "book", "chapter", "verses", "color", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "email",
      "google.com",
      "phone"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/users/{userId}/disciplineHistory/{logId}": {
      "schema": {
        "$ref": "#/entities/DailyDisciplineLog"
      },
      "description": "Stores a user's daily discipline completion history."
    },
    "/users/{userId}/bibleHighlights/{highlightId}": {
      "schema": {
        "$ref": "#/entities/BibleHighlight"
      },
      "description": "Stores a user's Bible highlights and notes."
    },
    "/souls/{soulId}": {
      "schema": {
        "$ref": "#/entities/Soul"
      },
      "description": "A global collection of all souls won, for aggregation purposes."
    },
    "/users/{userId}/souls/{soulId}": {
      "schema": {
        "$ref": "#/entities/Soul"
      },
      "description": "Stores souls won by a specific user."
    },
    "/users/{userId}/joinedCampaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/JoinedCampaign"
      },
      "description": "Stores a record of campaigns a user has joined."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Stores notifications for a specific user."
    },
    "/testimonies/{testimonyId}": {
      "schema": {
        "$ref": "#/entities/Testimony"
      },
      "description": "Stores user-submitted testimonies."
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Stores user-created campaigns."
    },
    "/campaigns/{campaignId}/participants/{userId}": {
      "schema": {
        "$ref": "#/entities/CampaignParticipant"
      },
      "description": "Stores participants of a specific campaign, allowing the organizer to see who has joined."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "Stores private chat sessions between a user and campaign organizer."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Stores messages for a specific chat session."
    },
    "/accountabilityRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/AccountabilityRequest"
      },
      "description": "Stores accountability partnership requests between users."
    },
    "/mail/{mailId}": {
      "schema": {
        "$ref": "#/entities/Mail"
      },
      "description": "Emails to be sent by the Trigger Email extension."
    }
  }
}
