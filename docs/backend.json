{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "fullName_lowercase": {
          "type": "string",
          "description": "The user's full name, lowercased for searching."
        },
        "name_tokens": {
          "type": "array",
          "description": "An array of lowercased words from the first and last name for searching.",
          "items": { "type": "string" }
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "backgroundImage": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's chosen app background image."
        },
        "backgroundOverlayOpacity": {
          "type": "number",
          "description": "The opacity of the overlay on top of the background image."
        },
        "bio": {
          "type": "string",
          "description": "The user's personal testimony."
        },
        "videoTestimonies": {
          "type": "array",
          "description": "A collection of YouTube video testimony links.",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "title": { "type": "string" }
            },
            "required": ["url"]
          }
        },
        "location": {
          "type": "object",
          "description": "The user's location. The city, state, and country are public, while latitude and longitude are private and used for geosensitive features.",
          "properties": {
            "city": { "type": "string", "description": "The user's city." },
            "state": { "type": "string", "description": "The user's state or province." },
            "country": { "type": "string", "description": "The user's country." },
            "city_lowercase": { "type": "string", "description": "Lowercase city for searching and aggregation." },
            "state_lowercase": { "type": "string", "description": "Lowercase state for searching and aggregation." },
            "country_lowercase": { "type": "string", "description": "Lowercase country for aggregation." },
            "latitude": { "type": "number", "description": "The user's private latitude for proximity calculations." },
            "longitude": { "type": "number", "description": "The user's private longitude for proximity calculations." }
          }
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "defaultMeetingLink": {
          "type": "string",
          "format": "uri",
          "description": "The user's default virtual meeting link (e.g., Google Meet)."
        },
        "dailyDiscipline": {
          "type": "object",
          "description": "Tracks the user's completed daily disciplines for the current day.",
          "properties": {
            "completed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lastUpdated": {
              "type": "object"
            }
          }
        },
        "readingHistory": {
          "type": "array",
          "description": "A log of the user's Bible reading sessions.",
          "items": {
            "type": "object",
            "properties": {
              "book": {
                "type": "string"
              },
              "chapter": {
                "type": "number"
              },
              "readAt": {
                "type": "object"
              }
            },
            "required": [
              "book",
              "chapter",
              "readAt"
            ]
          }
        },
        "prayerLinks": {
          "type": "array",
          "description": "A list of personal prayer links.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ]
          }
        },
        "notificationSettings": {
          "type": "object",
          "description": "User's notification preferences.",
          "properties": {
            "newCampaignsInArea": {
              "type": "boolean",
              "description": "Notify user about new campaigns in their area."
            },
            "weeklyDigest": {
              "type": "boolean",
              "description": "Send a weekly summary of activity."
            }
          }
        },
        "accountabilityPartners": {
            "type": "array",
            "description": "A list of the user's accountability partners.",
            "items": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string",
                        "description": "The UID of the accountability partner."
                    },
                    "firstName": {
                        "type": "string",
                        "description": "The first name of the accountability partner."
                    },
                    "lastName": {
                        "type": "string",
                        "description": "The last name of the accountability partner."
                    },
                    "photoURL": {
                        "type": "string",
                        "format": "uri",
                        "description": "The photo URL of the accountability partner."
                    }
                },
                "required": ["userId", "firstName"]
            }
        },
        "partnerIds": {
            "type": "array",
            "description": "An array of partner UIDs for efficient security rule checks.",
            "items": { "type": "string" }
        },
        "lastChurchAttended": {
          "type": "string",
          "description": "The name of the last church the user attended."
        },
        "churchInfo": {
            "type": "object",
            "description": "The user's primary church details.",
            "properties": {
                "name": { "type": "string", "description": "The name of the user's church." },
                "branch": { "type": "string", "description": "The specific branch of the church, if applicable." },
                "location": { "type": "string", "description": "The city or area of the church." },
                "schedule": {
                  "type": "array",
                  "description": "The user's worship schedule, with each item containing a day and time.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "day": { "type": "string" },
                      "time": { "type": "string" },
                      "url": { "type": "string", "format": "uri", "description": "The URL for the live stream of the service." }
                    },
                    "required": ["day", "time"]
                  }
                }
            }
        },
        "attendanceHistory": {
            "type": "array",
            "description": "A log of the user's church attendance.",
            "items": {
                "type": "object",
                "properties": {
                    "churchName": { "type": "string", "description": "Name of the church attended." },
                    "branch": { "type": "string", "description": "The specific branch of the church, if applicable." },
                    "location": { "type": "string", "description": "The city or area of the church." },
                    "attendedAt": { "type": "object" },
                    "reason": { "type": "string", "description": "The reason or notes for attending the service." }
                },
                "required": ["churchName", "attendedAt"]
            }
        },
        "monthlySoulsGoal": {
          "type": "number",
          "description": "The user's personal goal for souls won for the current month."
        },
        "lastActive": {
          "type": "object",
          "description": "Timestamp of the user's last activity."
        },
        "isVendor": { "type": "boolean" },
        "organizationId": { "type": "string", "description": "The ID of the organization this user belongs to." },
        "kingdomPoints": { "type": "number", "description": "Total spiritual engagement points." }
      },
      "required": [
        "firstName",
        "lastName",
        "email"
      ]
    },
    "GameSession": {
      "title": "Game Session",
      "description": "A recorded session of a Kingdom challenge between partners.",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" },
        "partnerId": { "type": "string" },
        "score": { "type": "number" },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["participantIds", "userId", "score"]
    },
    "GameInvitation": {
      "title": "Game Invitation",
      "description": "A request for a live Word challenge.",
      "type": "object",
      "properties": {
        "hostId": { "type": "string" },
        "guestId": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "expired"] },
        "createdAt": { "type": "object" },
        "acceptedAt": { "type": "object" }
      },
      "required": ["hostId", "guestId", "participantIds", "status"]
    }
  },
  "auth": {
    "providers": [
      "email",
      "google.com",
      "phone"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/gameSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/GameSession" },
      "description": "History of Word challenges."
    },
    "/gameInvitations/{invitationId}": {
        "schema": { "$ref": "#/entities/GameInvitation" },
        "description": "Real-time handshakes for live challenges."
    }
  }
}
