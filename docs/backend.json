
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "fullName_lowercase": {
          "type": "string",
          "description": "The user's full name, lowercased for searching."
        },
        "name_tokens": {
          "type": "array",
          "description": "An array of lowercased words from the first and last name for searching.",
          "items": {
            "type": "string"
          }
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "backgroundImage": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's chosen app background image."
        },
        "backgroundOverlayOpacity": {
          "type": "number",
          "description": "The opacity of the overlay on top of the background image."
        },
        "bio": {
          "type": "string",
          "description": "The user's personal testimony."
        },
        "videoTestimonies": {
          "type": "array",
          "description": "A collection of YouTube video testimony links.",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          }
        },
        "location": {
          "type": "object",
          "description": "The user's location. The city, state, and country are public, while latitude and longitude are private and used for geosensitive features.",
          "properties": {
            "city": {
              "type": "string",
              "description": "The user's city."
            },
            "state": {
              "type": "string",
              "description": "The user's state or province."
            },
            "country": {
              "type": "string",
              "description": "The user's country."
            },
            "city_lowercase": {
              "type": "string",
              "description": "Lowercase city for searching and aggregation."
            },
            "state_lowercase": {
              "type": "string",
              "description": "Lowercase state for searching and aggregation."
            },
            "country_lowercase": {
              "type": "string",
              "description": "Lowercase country for aggregation."
            },
            "latitude": {
              "type": "number",
              "description": "The user's private latitude for proximity calculations."
            },
            "longitude": {
              "type": "number",
              "description": "The user's private longitude for proximity calculations."
            }
          }
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "defaultMeetingLink": {
          "type": "string",
          "format": "uri",
          "description": "The user's default virtual meeting link (e.g., Google Meet)."
        },
        "dailyDiscipline": {
          "type": "object",
          "description": "Tracks the user's completed daily disciplines for the current day.",
          "properties": {
            "completed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lastUpdated": {
              "type": "object"
            }
          }
        },
        "readingHistory": {
          "type": "array",
          "description": "A log of the user's Bible reading sessions.",
          "items": {
            "type": "object",
            "properties": {
              "book": {
                "type": "string"
              },
              "chapter": {
                "type": "number"
              },
              "readAt": {
                "type": "object"
              }
            },
            "required": [
              "book",
              "chapter",
              "readAt"
            ]
          }
        },
        "prayerLinks": {
          "type": "array",
          "description": "A list of personal prayer links.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ]
          }
        },
        "notificationSettings": {
          "type": "object",
          "description": "User's notification preferences.",
          "properties": {
            "newCampaignsInArea": {
              "type": "boolean",
              "description": "Notify user about new campaigns in their area."
            },
            "weeklyDigest": {
              "type": "boolean",
              "description": "Send a weekly summary of activity."
            }
          }
        },
        "accountabilityPartners": {
          "type": "array",
          "description": "A list of the user's accountability partners.",
          "items": {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string",
                "description": "The UID of the accountability partner."
              },
              "firstName": {
                "type": "string",
                "description": "The first name of the accountability partner."
              },
              "lastName": {
                "type": "string",
                "description": "The last name of the accountability partner."
              },
              "photoURL": {
                "type": "string",
                "format": "uri",
                "description": "The photo URL of the accountability partner."
              }
            },
            "required": [
              "userId",
              "firstName"
            ]
          }
        },
        "partnerIds": {
          "type": "array",
          "description": "An array of partner UIDs for efficient security rule checks.",
          "items": {
            "type": "string"
          }
        },
        "lastChurchAttended": {
          "type": "string",
          "description": "The name of the last church the user attended."
        },
        "churchInfo": {
          "type": "object",
          "description": "The user's primary church details.",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name of the user's church."
            },
            "branch": {
              "type": "string",
              "description": "The specific branch of the church, if applicable."
            },
            "location": {
              "type": "string",
              "description": "The city or area of the church."
            },
            "schedule": {
              "type": "array",
              "description": "The user's worship schedule, with each item containing a day and time.",
              "items": {
                "type": "object",
                "properties": {
                  "day": {
                    "type": "string"
                  },
                  "time": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL for the live stream of the service."
                  }
                },
                "required": [
                  "day",
                  "time"
                ]
              }
            }
          }
        },
        "attendanceHistory": {
          "type": "array",
          "description": "A log of the user's church attendance.",
          "items": {
            "type": "object",
            "properties": {
              "churchName": {
                "type": "string",
                "description": "Name of the church attended."
              },
              "branch": {
                "type": "string",
                "description": "The specific branch of the church, if applicable."
              },
              "location": {
                "type": "string",
                "description": "The city or area of the church."
              },
              "attendedAt": {
                "type": "object"
              },
              "reason": {
                "type": "string",
                "description": "The reason or notes for attending the service."
              }
            },
            "required": [
              "churchName",
              "attendedAt"
            ]
          }
        },
        "monthlySoulsGoal": {
          "type": "number",
          "description": "The user's personal goal for souls won for the current month."
        },
        "lastActive": {
          "type": "object",
          "description": "Timestamp of the user's last activity."
        },
        "isVendor": {
          "type": "boolean"
        },
        "organizationId": {
          "type": "string",
          "description": "The ID of the organization this user belongs to."
        },
        "kingdomPoints": {
          "type": "number",
          "description": "Total spiritual engagement points earned through arena activities."
        },
        "lastGameAt": {
          "type": "object",
          "description": "Timestamp of the user's last Kingdom Arena participation."
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email"
      ]
    },
    "GameSession": {
      "title": "Game Session",
      "description": "A recorded session of a Kingdom challenge between partners.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userId": {
          "type": "string"
        },
        "partnerId": {
          "type": "string"
        },
        "gameType": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "correctCount": {
          "type": "number"
        },
        "wrongCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "participantIds",
        "userId",
        "score"
      ]
    },
    "GameInvitation": {
      "title": "Game Invitation",
      "description": "A request for a live Word challenge.",
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string"
        },
        "guestId": {
          "type": "string"
        },
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "declined",
            "expired"
          ]
        },
        "gameType": {
          "type": "string"
        },
        "timerDuration": {
          "type": "number",
          "description": "The duration of the challenge in seconds."
        },
        "createdAt": {
          "type": "object"
        },
        "acceptedAt": {
          "type": "object"
        }
      },
      "required": [
        "hostId",
        "guestId",
        "participantIds",
        "status"
      ]
    },
    "CartItem": {
      "title": "Cart Item",
      "description": "Represents an item in the user's kindness or provision cart.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "quantity": {
          "type": "number"
        },
        "vendorId": {
          "type": "string"
        },
        "vendorName": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "photoURL": {
          "type": "string",
          "format": "uri"
        },
        "soulId": {
          "type": "string"
        },
        "soulName": {
          "type": "string"
        }
      }
    },
    "Ad": {
      "title": "Advertisement",
      "description": "Promotional content for Kingdom enterprises or missions.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "business",
            "event"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        }
      }
    },
    "RegionalChallenge": {
      "title": "Regional Challenge",
      "description": "A challenge faced in a specific region requiring Kingdom solutions.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "country": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoURL": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "solutionCount": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "description", "country", "authorId", "status"]
    },
    "ChallengeSolution": {
      "title": "Challenge Solution",
      "description": "A proposed solution or word of wisdom for a regional challenge.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "object" },
        "upvotes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["text", "authorId", "createdAt"]
    },
    "Witness": {
      "title": "Witness",
      "description": "A formal endorsement or secondary account of a shared miracle.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorFirstName": { "type": "string" },
        "authorLastName": { "type": "string" },
        "authorAvatarUrl": { "type": "string", "format": "uri" },
        "text": { "type": "string", "description": "The witness's account or confirmation." },
        "createdAt": { "type": "object" },
        "testimonyId": { "type": "string" }
      },
      "required": ["authorId", "text", "createdAt", "testimonyId"]
    }
  },
  "auth": {
    "providers": [
      "email",
      "google.com",
      "phone"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": {
        "$ref": "#/entities/CartItem"
      },
      "description": "User's shopping cart for Kingdom provisions."
    },
    "/gameSessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/GameSession"
      },
      "description": "History of Word challenges."
    },
    "/gameInvitations/{invitationId}": {
      "schema": {
        "$ref": "#/entities/GameInvitation"
      },
      "description": "Real-time handshakes for live challenges."
    },
    "/ads/{adId}": {
      "schema": {
        "$ref": "#/entities/Ad"
      },
      "description": "Global promotional spots."
    },
    "/regionalChallenges/{challengeId}": {
      "schema": {
        "$ref": "#/entities/RegionalChallenge"
      },
      "description": "Shared regional challenges."
    },
    "/regionalChallenges/{challengeId}/solutions/{solutionId}": {
      "schema": {
        "$ref": "#/entities/ChallengeSolution"
      },
      "description": "Solutions proposed for regional challenges."
    },
    "/testimonies/{testimonyId}/witnesses/{witnessId}": {
      "schema": {
        "$ref": "#/entities/Witness"
      },
      "description": "Formal endorsements for a testimony."
    }
  }
}
