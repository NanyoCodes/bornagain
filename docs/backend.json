{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "bio": {
          "type": "string",
          "description": "A short user biography."
        },
        "location": {
          "type": "string",
          "description": "The user's general location."
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        }
      },
      "required": [
        "displayName",
        "email"
      ]
    },
    "Testimony": {
      "title": "Testimony",
      "description": "A user's testimony of what God has done.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorAvatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "content",
        "category",
        "authorId",
        "authorName",
        "createdAt"
      ]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A user-created evangelism campaign.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "startDate": {
          "type": "object"
        },
        "endDate": {
          "type": "object"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "participants": {
          "type": "number"
        },
        "progress": {
          "type": "number"
        },
        "createdAt": {
          "type": "object"
        },
        "organizerId": {
          "type": "string"
        },
        "organizerName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deleted"
          ],
          "description": "The current status of the campaign."
        },
        "lastUpdateReason": {
          "type": "string",
          "description": "The reason for the last update."
        },
        "deletionReason": {
          "type": "string",
          "description": "The reason for deleting the campaign."
        },
        "deletedAt": {
          "type": "object",
          "description": "Timestamp when the campaign was deleted."
        }
      },
      "required": [
        "title",
        "description",
        "location",
        "startDate",
        "endDate",
        "startTime",
        "endTime",
        "createdAt",
        "organizerId",
        "organizerName"
      ]
    },
    "Soul": {
      "title": "Soul",
      "description": "Represents a person led to Christ, tracked by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "church": {
          "type": "string",
          "description": "The church the soul is attending."
        },
        "source": {
          "type": "string",
          "enum": [
            "Personal",
            "Campaign",
            "Referral"
          ]
        },
        "sourceDetails": {
          "type": "string"
        },
        "wonAt": {
          "type": "object"
        },
        "status": {
          "type": "string"
        },
        "followUpLog": {
          "type": "array"
        },
        "attendingChurch": {
          "type": "boolean"
        },
        "inBibleStudy": {
          "type": "boolean"
        },
        "attendingPrayer": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "name",
        "source",
        "wonAt",
        "status"
      ]
    },
    "JoinedCampaign": {
      "title": "Joined Campaign",
      "description": "A record of a user joining a campaign.",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "campaignId",
        "joinedAt"
      ]
    },
    "CampaignParticipant": {
      "title": "Campaign Participant",
      "description": "Represents a user who has joined a campaign.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "userId",
        "displayName",
        "email",
        "joinedAt"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "A private chat session between a user and a campaign owner.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "participantInfo": {
          "type": "object"
        },
        "campaignId": {
          "type": "string"
        },
        "campaignTitle": {
          "type": "string"
        },
        "lastMessageText": {
          "type": "string"
        },
        "lastUpdatedAt": {
          "type": "object"
        }
      },
      "required": [
        "participantIds",
        "campaignId",
        "lastUpdatedAt"
      ]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single message within a chat session.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "senderId",
        "text",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "email",
      "google.com",
      "facebook.com",
      "phone"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/users/{userId}/souls/{soulId}": {
      "schema": {
        "$ref": "#/entities/Soul"
      },
      "description": "Stores souls won by a specific user."
    },
    "/users/{userId}/joinedCampaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/JoinedCampaign"
      },
      "description": "Stores a record of campaigns a user has joined."
    },
    "/testimonies/{testimonyId}": {
      "schema": {
        "$ref": "#/entities/Testimony"
      },
      "description": "Stores user-submitted testimonies."
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Stores user-created campaigns."
    },
    "/campaigns/{campaignId}/participants/{userId}": {
      "schema": {
        "$ref": "#/entities/CampaignParticipant"
      },
      "description": "Stores participants of a specific campaign, allowing the organizer to see who has joined."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "Stores private chat sessions between users."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Stores messages for a specific chat session."
    }
  }
}
