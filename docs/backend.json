
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "bio": {
          "type": "string",
          "description": "The user's personal testimony."
        },
        "location": {
          "type": "object",
          "description": "The user's location.",
          "properties": {
            "city": { "type": "string", "description": "The user's city." },
            "country": { "type": "string", "description": "The user's country." }
          }
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        },
        "currentStreak": {
          "type": "number",
          "description": "The user's current daily app usage streak."
        },
        "longestStreak": {
          "type": "number",
          "description": "The user's longest daily app usage streak."
        },
        "lastLogin": {
          "type": "object",
          "description": "Timestamp of the user's last daily app usage."
        },
        "dailyDiscipline": {
          "type": "object",
          "description": "Tracks the user's completed daily disciplines for the current day.",
          "properties": {
            "completed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lastUpdated": {
              "type": "object"
            }
          }
        },
        "readingHistory": {
          "type": "array",
          "description": "A log of the user's Bible reading sessions.",
          "items": {
            "type": "object",
            "properties": {
              "book": {
                "type": "string"
              },
              "chapter": {
                "type": "number"
              },
              "readAt": {
                "type": "object"
              }
            },
            "required": [
              "book",
              "chapter",
              "readAt"
            ]
          }
        },
        "notificationSettings": {
          "type": "object",
          "description": "User's notification preferences.",
          "properties": {
            "newCampaignsInArea": {
              "type": "boolean",
              "description": "Notify user about new campaigns in their area."
            },
            "weeklyDigest": {
              "type": "boolean",
              "description": "Send a weekly summary of activity."
            }
          }
        },
        "privacySettings": {
          "type": "object",
          "description": "User's privacy preferences.",
          "properties": {
            "profileVisibility": {
              "type": "string",
              "enum": [
                "public",
                "private"
              ],
              "description": "Controls who can see the user's profile."
            },
            "showLocation": {
              "type": "boolean",
              "description": "Allow others to see the user's city and country."
            }
          }
        }
      },
      "required": [
        "displayName",
        "email"
      ]
    },
    "Testimony": {
      "title": "Testimony",
      "description": "A user's testimony of what God has done.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorAvatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "content",
        "category",
        "authorId",
        "authorName",
        "createdAt"
      ]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A user-created evangelism campaign.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "startDate": {
          "type": "object"
        },
        "endDate": {
          "type": "object"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "participants": {
          "type": "number"
        },
        "maxParticipants": {
          "type": "number",
          "description": "The maximum number of participants allowed in the campaign."
        },
        "createdAt": {
          "type": "object"
        },
        "organizerId": {
          "type": "string"
        },
        "organizerName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deleted"
          ],
          "description": "The current status of the campaign."
        },
        "lastUpdateReason": {
          "type": "string",
          "description": "The reason for the last update."
        },
        "deletionReason": {
          "type": "string",
          "description": "The reason for deleting the campaign."
        },
        "deletedAt": {
          "type": "object",
          "description": "Timestamp when the campaign was deleted."
        },
        "scripture": {
          "type": "string",
          "description": "An inspirational scripture for the campaign."
        },
        "scriptureTestimony": {
          "type": "string",
          "description": "The organizer's personal testimony or caption related to the scripture."
        },
        "soulsLogged": {
          "type": "number",
          "description": "The total number of souls logged for this campaign."
        }
      },
      "required": [
        "title",
        "description",
        "location",
        "startDate",
        "endDate",
        "startTime",
        "endTime",
        "createdAt",
        "organizerId",
        "organizerName"
      ]
    },
    "Soul": {
      "title": "Soul",
      "description": "Represents a person led to Christ, tracked by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
            "type": "string",
            "format": "email",
            "description": "The soul's email address."
        },
        "phone": {
            "type": "string",
            "description": "The soul's phone number."
        },
        "church": {
          "type": "string",
          "description": "The church the soul is attending."
        },
        "source": {
          "type": "string",
          "enum": [
            "Personal",
            "Campaign",
            "Referral"
          ]
        },
        "sourceDetails": {
          "type": "string"
        },
        "campaignId": {
          "type": "string",
          "description": "The ID of the campaign this soul was won through."
        },
        "userLocation": {
          "type": "object",
          "description": "The location of the user who won the soul.",
          "properties": {
            "city": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "wonAt": {
          "type": "object"
        },
        "status": {
          "type": "string"
        },
        "followUpLog": {
          "type": "array"
        },
        "attendingChurch": {
          "type": "boolean"
        },
        "inBibleStudy": {
          "type": "boolean"
        },
        "attendingPrayer": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "name",
        "source",
        "wonAt",
        "status"
      ]
    },
    "JoinedCampaign": {
      "title": "Joined Campaign",
      "description": "A record of a user joining a campaign.",
      "type": "object",
      "properties": {
        "campaignId": {
          "type": "string"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "campaignId",
        "joinedAt"
      ]
    },
    "CampaignParticipant": {
      "title": "Campaign Participant",
      "description": "Represents a user who has joined a campaign.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "photoURL": {
          "type": "string",
          "format": "uri"
        },
        "joinedAt": {
          "type": "object"
        }
      },
      "required": [
        "userId",
        "displayName",
        "joinedAt"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "A chat session for a campaign, which can be a group chat among participants or a private one-on-one chat.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "participantInfo": {
          "type": "object"
        },
        "campaignId": {
          "type": "string"
        },
        "campaignTitle": {
          "type": "string"
        },
        "isGroupChat": {
          "type": "boolean",
          "description": "Indicates if this is a group chat for the whole campaign."
        },
        "lastUpdatedAt": {
          "type": "object"
        }
      },
      "required": [
        "participantIds",
        "campaignId",
        "lastUpdatedAt"
      ]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single message within a chat session.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "senderId",
        "createdAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents an in-app notification for a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who should receive the notification."
        },
        "type": {
          "type": "string",
          "enum": ["campaign_join", "new_chat_message"]
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "description": "A URL link to the relevant page (e.g., campaign or chat)."
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": ["userId", "type", "title", "message", "isRead", "createdAt"]
    },
    "Mail": {
      "title": "Mail",
      "description": "An email to be sent by the Trigger Email extension.",
      "type": "object",
      "properties": {
        "toUids": {
          "type": "array",
          "description": "A list of user UIDs to send the email to.",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string"
            },
            "html": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "toUids",
        "message"
      ]
    }
  },
  "auth": {
    "providers": [
      "email",
      "google.com",
      "phone"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data, keyed by user ID."
    },
    "/souls/{soulId}": {
      "schema": {
        "$ref": "#/entities/Soul"
      },
      "description": "A global collection of all souls won, for aggregation purposes."
    },
    "/users/{userId}/souls/{soulId}": {
      "schema": {
        "$ref": "#/entities/Soul"
      },
      "description": "Stores souls won by a specific user."
    },
    "/users/{userId}/joinedCampaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/JoinedCampaign"
      },
      "description": "Stores a record of campaigns a user has joined."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Stores notifications for a specific user."
    },
    "/testimonies/{testimonyId}": {
      "schema": {
        "$ref": "#/entities/Testimony"
      },
      "description": "Stores user-submitted testimonies."
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Stores user-created campaigns."
    },
    "/campaigns/{campaignId}/participants/{userId}": {
      "schema": {
        "$ref": "#/entities/CampaignParticipant"
      },
      "description": "Stores participants of a specific campaign, allowing the organizer to see who has joined."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "Stores private chat sessions between a user and campaign organizer."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Stores messages for a specific chat session."
    },
    "/mail/{mailId}": {
      "schema": {
        "$ref": "#/entities/Mail"
      },
      "description": "Emails to be sent by the Trigger Email extension."
    }
  }
}
