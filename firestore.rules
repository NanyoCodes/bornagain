
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can view any profile, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Souls are private to the user who won them.
    match /users/{userId}/souls/{soulId} {
    	allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Records of joined campaigns are private to the user.
    match /users/{userId}/joinedCampaigns/{campaignId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications are private to the user.
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Testimonies are public to all authenticated users, but only writable by the author.
    match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Campaigns are public to all authenticated users.
    // Creating a campaign is allowed for authenticated users.
    // Updates are restricted to the organizer, except for incrementing participant count.
    // Deletes are soft-deletes (an update), hard deletes are disallowed.
    match /campaigns/{campaignId} {
    	allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Case 1: A user is joining the campaign.
        // This is only allowed to increment the participant count by 1.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
          request.resource.data.participants == resource.data.participants + 1
        ) ||
        // Case 2: The organizer is updating the campaign (including soft-deleting).
        // They can change anything except for the participant count.
        (
          request.auth.uid == resource.data.organizerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
        )
      );
      allow delete: if false; // Hard deletes are disallowed.

      // Campaign organizers can read participants.
      // Users can add/remove themselves as a participant.
      match /participants/{userId} {
        allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Chat rules
    match /chats/{chatId} {
      // User can create a chat if they are one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      // User can get/list chats they are a participant in
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // User can update a chat (e.g. last message) if they are a participant
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;

      // No one can delete a chat history
      allow delete: if false;

      match /messages/{messageId} {
        // User can read messages in a chat they are a part of
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // User can create a message if they are a participant and the sender
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        // Messages are immutable
        allow update, delete: if false; 
      }
    }
  }
}
