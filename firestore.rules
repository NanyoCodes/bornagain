
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function arePartners(user1, user2) {
      // Check that both users exist.
      let user1Exists = exists(/databases/$(database)/documents/users/$(user1));
      let user2Exists = exists(/databases/$(database)/documents/users/$(user2));
      if (!user1Exists || !user2Exists) {
        return false;
      }

      // Get data for both users.
      let user1Data = get(/databases/$(database)/documents/users/$(user1)).data;
      let user2Data = get(/databases/$(database)/documents/users/$(user2)).data;

      // Check if partnerIds field exists and is a list on both documents.
      let user1HasPartnerList = 'partnerIds' in user1Data && user1Data.partnerIds is list;
      let user2HasPartnerList = 'partnerIds' in user2Data && user2Data.partnerIds is list;
      if (!user1HasPartnerList || !user2HasPartnerList) {
        return false;
      }

      // Symmetrically check for partnership.
      return user2 in user1Data.partnerIds && user1 in user2Data.partnerIds;
    }

    // User profile access rules and all subcollections
    match /users/{userId} {
      // Allow any authenticated user to read user profiles
      allow read: if request.auth != null;
      
      // A user can create or delete their own profile.
      allow create, delete: if request.auth != null && request.auth.uid == userId;

      // Update permissions are more complex.
      allow update: if request.auth != null && (
        // A user can update their own document, but not the partners list directly.
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountabilityPartners', 'partnerIds'])) ||

        // A user can remove a partner from their OWN list.
        (
          request.auth.uid == userId &&
          'accountabilityPartners' in resource.data &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) &&
          request.resource.data.accountabilityPartners.size() == resource.data.accountabilityPartners.size() - 1
        ) ||
        
        // A user can ADD a partner to their OWN list. This is safe because it's only called in a transaction
        // that also updates the other user's list, which IS strictly validated against a pending request.
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) &&
          request.resource.data.accountabilityPartners.size() == ('accountabilityPartners' in resource.data ? resource.data.accountabilityPartners.size() : 0) + 1
        ) ||
        
        // A user (acceptor) can be ADDED to another user's (sender's) partner list.
        (
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) &&
          request.resource.data.accountabilityPartners.size() == ('accountabilityPartners' in resource.data ? resource.data.accountabilityPartners.size() : 0) + 1 &&
          // A pending request from the sender (userId) to the acceptor (request.auth.uid) must exist.
          (
            (
                exists(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)) &&
                get(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)).data.status == 'pending' &&
                get(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)).data.toUserId == request.auth.uid
            ) || (
                exists(/databases/$(database)/documents/accountabilityRequests/$(request.auth.uid + '_' + userId)) &&
                get(/databases/$(database)/documents/accountabilityRequests/$(request.auth.uid + '_' + userId)).data.status == 'pending' &&
                get(/databases/$(database)/documents/accountabilityRequests/$(request.auth.uid + '_' + userId)).data.toUserId == request.auth.uid
            )
          )
        ) ||
        
        // A user can remove themselves from a partner's list.
        (
            request.auth.uid != userId &&
            arePartners(request.auth.uid, userId) &&
            'accountabilityPartners' in resource.data &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) &&
            request.resource.data.accountabilityPartners.size() == resource.data.accountabilityPartners.size() - 1
        )
      );

      // --- Subcollection Rules ---

      // Souls are private to the user.
      match /souls/{soulId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Joined campaigns are private to the user.
      match /joinedCampaigns/{campaignId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Discipline history is only readable by the user and their accountability partners.
      match /disciplineHistory/{logId} {
        allow get, list: if request.auth != null && (
            request.auth.uid == userId ||
            (
              // Inlined symmetric check for partnership to ensure reliability
              exists(/databases/$(database)/documents/users/$(userId)) &&
              'partnerIds' in get(/databases/$(database)/documents/users/$(userId)).data &&
              request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.partnerIds &&

              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              'partnerIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
              userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerIds
            )
        );
        
        // Only the user can write to their own discipline history.
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Bible highlights are private to the user.
      match /bibleHighlights/{highlightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Notifications are private to the user, though others can create them.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Global souls collection for aggregation.
    match /souls/{soulId} {
      allow get, list: if request.auth != null;
      // Allow any authenticated user to create a document here.
      // The user's private /users/{userId}/souls collection has the stricter rule.
      allow create: if request.auth != null;
      allow update, delete: if false; // Immutable
    }

    // Testimonies are public, but only writable by the author.
    match /testimonies/{testimonyId} {
      allow get, list: if true;
      
      // Author can create, update (non-supporter fields), or delete their own testimony.
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      
      allow update: if request.auth != null && (
        // Author can update their own testimony content
        (resource.data.authorId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['supporters'])) ||
        // Any authenticated user can support a testimony.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']) &&
          request.resource.data.supporters.size() == ('supporters' in resource.data ? resource.data.supporters.size() : 0) + 1 &&
          request.auth.uid in request.resource.data.supporters
        )
      );
    }
    
    // Prayer Requests are public.
    match /prayerRequests/{requestId} {
      allow get, list: if true; // Publicly readable for the community to pray

      // Author can create their own prayer request. authorId is required.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;

      // Any authenticated user can pray for a request by adding their UID to the usersWhoPrayed list.
      allow update: if request.auth != null
                    // The only field changing is usersWhoPrayed
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usersWhoPrayed'])
                    // The user is adding themselves, and not removing anyone
                    && request.resource.data.usersWhoPrayed.size() == ('usersWhoPrayed' in resource.data ? resource.data.usersWhoPrayed.size() : 0) + 1
                    && request.auth.uid in request.resource.data.usersWhoPrayed;

      // Author can delete their own prayer request.
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Campaigns are public to read.
    // Updates are restricted based on user role and action.
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow delete: if false; // Hard deletes are disallowed. Status is updated instead.

      allow update: if request.auth != null && (
        // SCENARIO 1: Organizer updates details (including soft delete).
        (
          request.auth.uid == resource.data.organizerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'soulsLogged'])
        ) ||
        // SCENARIO 2: A user logs a soul.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soulsLogged']) &&
          request.resource.data.soulsLogged == (resource.data.soulsLogged || 0) + 1
        ) ||
        // SCENARIO 3: A user joins a campaign.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
          request.resource.data.participants == resource.data.participants + 1 &&
          (resource.data.maxParticipants == null || resource.data.participants < resource.data.maxParticipants)
        )
      );

      // Rules for the participants subcollection.
      match /participants/{userId} {
        // A user can read/write their own participant document.
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // The organizer can see the list of participants.
        allow list: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId;
      }
    }
    
    // Chat rules
    match /chats/{chatId} {
      // User can create a chat if they are one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      // User can get/list chats they are a participant in
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // User can update a chat (e.g. last message) if they are a participant
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;

      // No one can delete a chat history
      allow delete: if false;

      match /messages/{messageId} {
        // User can read messages in a chat they are a part of
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // User can create a message if they are a participant and the sender
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        // Messages are immutable
        allow update, delete: if false; 
      }
    }

    // Accountability Requests
    match /accountabilityRequests/{requestId} {
      // Allow a user to get/list requests they are a part of.
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // Allow a user to create a request if they are the sender and both participants are in the list.
      // ID must be predictable: {uid1_uid2}
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUserId
                    && request.resource.data.fromUserId in request.resource.data.participantIds
                    && request.resource.data.toUserId in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2
                    && requestId == request.resource.data.participantIds.join('_');

      // Recipient can accept/decline a pending request
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId
                  && request.resource.data.status in ['accepted', 'declined']
                  && resource.data.status == 'pending';
                  
      // Sender can cancel a pending request. Either party can delete an accepted/declined request.
      allow delete: if request.auth != null && (
          (request.auth.uid == resource.data.fromUserId && resource.data.status == 'pending') ||
          (resource.data.status in ['accepted', 'declined'] && request.auth.uid in resource.data.participantIds)
      );
    }

    // Trigger Email extension collection
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
