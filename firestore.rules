
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile access rules
    match /users/{userId} {
      // Any authenticated user can list users (for searching).
      // The query will be filtered on the client, and this just allows the query to run.
      allow list: if request.auth != null;

      // Users can get their own profile, or their accountability partner's profile.
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        (
          // Allow reading partner's doc if my doc has their ID
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountabilityPartnerId', null) == userId
        ) ||
        (
          // Allow reading my doc if the requested doc has my ID (for symmetry)
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.get('accountabilityPartnerId', null) == request.auth.uid
        )
      );

      // Users can only write to their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Global souls collection for aggregation.
    match /souls/{soulId} {
      allow list, get: if request.auth != null;
      // Allow a user to create a soul record if the userId in the document matches their auth uid.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable
    }

    // Souls are private to the user who won them.
    match /users/{userId}/souls/{soulId} {
    	allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Records of joined campaigns are private to the user. Organizer can remove.
    match /users/{userId}/joinedCampaigns/{campaignId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId == request.auth.uid
      );
    }

    // Notifications are private to the user for read/update/delete.
    // Any authenticated user can create a notification for another user.
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Testimonies are public to all authenticated users, but only writable by the author.
    match /testimonies/{testimonyId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && request.auth.uid == resource.data.authorId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Campaigns are public to all authenticated users.
    // Updates are restricted to the organizer, except for changing participant count.
    match /campaigns/{campaignId} {
    	allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Case 1: A user is joining the campaign.
        (
          request.resource.data.diff(resource.data).affectedKeys().size() == 1 &&
          'participants' in request.resource.data.diff(resource.data).affectedKeys() &&
          request.resource.data.participants == resource.data.participants + 1
        ) ||
        // Case 2: The organizer is updating the campaign. They can change anything except participant and soul counts.
        (
          request.auth.uid == resource.data.organizerId &&
          !('participants' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('soulsLogged' in request.resource.data.diff(resource.data).affectedKeys())
        ) ||
        // Case 3: The organizer is removing a participant, which only decrements the participant count.
        (
          request.auth.uid == resource.data.organizerId &&
          request.resource.data.diff(resource.data).affectedKeys().size() == 1 &&
          'participants' in request.resource.data.diff(resource.data).affectedKeys() &&
          request.resource.data.participants == resource.data.participants - 1
        ) ||
        // Case 4: Any authenticated user is logging a soul for the campaign, which only increments the soulsLogged count.
        (
          request.resource.data.diff(resource.data).affectedKeys().size() == 1 &&
          'soulsLogged' in request.resource.data.diff(resource.data).affectedKeys() &&
          request.resource.data.soulsLogged == (resource.data.soulsLogged || 0) + 1
        )
      );
      allow delete: if false; // Hard deletes are disallowed.

      // Rules for the participants subcollection.
      match /participants/{userId} {
        // Organizer can see all participants
        allow read: if request.auth != null && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId == request.auth.uid;
        // A user can add themselves as a participant
        allow create: if request.auth != null && request.auth.uid == userId;
        // A user can remove themselves, or the organizer can remove any participant
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId == request.auth.uid
        );
        // No updates to participant docs are allowed.
        allow update: if false;
      }
    }
    
    // Chat rules
    match /chats/{chatId} {
      // User can create a chat if they are one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      // User can get/list chats they are a participant in
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // User can update a chat (e.g. last message) if they are a participant
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;

      // No one can delete a chat history
      allow delete: if false;

      match /messages/{messageId} {
        // User can read messages in a chat they are a part of
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // User can create a message if they are a participant and the sender
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        // Messages are immutable
        allow update, delete: if false; 
      }
    }

    // Accountability Requests
    match /accountabilityRequests/{requestId} {
      // Allow a user to get/list requests they are a part of.
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // Allow a user to create a request if they are the sender and both participants are in the list.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUserId
                    && request.resource.data.fromUserId in request.resource.data.participantIds
                    && request.resource.data.toUserId in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;

      // Recipient can accept/decline a pending request
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId
                  && request.resource.data.status in ['accepted', 'declined']
                  && resource.data.status == 'pending';
                  
      // Sender can delete/cancel a pending request
      allow delete: if request.auth != null && request.auth.uid == resource.data.fromUserId && resource.data.status == 'pending';
    }

    // Trigger Email extension collection
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
