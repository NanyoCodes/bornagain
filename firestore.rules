rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function arePartners(user1, user2) {
      let user1Data = get(/databases/$(database)/documents/users/$(user1)).data;
      let user2Data = get(/databases/$(database)/documents/users/$(user2)).data;
      
      return user1Data != null && 'partnerIds' in user1Data && user1Data.partnerIds is list && user2 in user1Data.partnerIds &&
             user2Data != null && 'partnerIds' in user2Data && user2Data.partnerIds is list && user1 in user2Data.partnerIds;
    }

    function isFellowshipMember(fellowshipId) {
      return request.auth != null && 
             fellowshipId != null && 
             fellowshipId is string && 
             fellowshipId != "" && 
             fellowshipId != "none" &&
             exists(/databases/$(database)/documents/fellowships/$(fellowshipId)) &&
             request.auth.uid in get(/databases/$(database)/documents/fellowships/$(fellowshipId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if isOwner(userId);

      allow update: if request.auth != null && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountabilityPartners', 'partnerIds'])) ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) && request.resource.data.accountabilityPartners.size() == (('accountabilityPartners' in resource.data) ? resource.data.accountabilityPartners.size() : 0) - 1) ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) && request.resource.data.accountabilityPartners.size() == (('accountabilityPartners' in resource.data) ? resource.data.accountabilityPartners.size() : 0) + 1) ||
        (!isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) && request.resource.data.accountabilityPartners.size() == (('accountabilityPartners' in resource.data) ? resource.data.accountabilityPartners.size() : 0) + 1 && ( (exists(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)) && get(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)).data.status == 'pending' && get(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)).data.toUserId == request.auth.uid) || (exists(/databases/$(database)/documents/accountabilityRequests/$(request.auth.uid + '_' + userId)) && get(/databases/$(database)/documents/accountabilityRequests/$(request.auth.uid + '_' + userId)).data.status == 'pending' && get(/databases/$(database)/documents/accountabilityRequests/$(request.auth.uid + '_' + userId)).data.toUserId == request.auth.uid) )) ||
        (!isOwner(userId) && (('partnerIds' in resource.data && request.auth.uid in resource.data.partnerIds) || ('accountabilityPartners' in resource.data && exists(/databases/$(database)/documents/accountabilityRequests/$(userId + '_' + request.auth.uid)))) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']) && request.resource.data.accountabilityPartners.size() == (('accountabilityPartners' in resource.data) ? resource.data.accountabilityPartners.size() : 0) - 1)
      );

      match /souls/{soulId} {
        allow read: if isOwner(userId) || isFellowshipMember(resource.data.fellowshipId);
        allow create: if isOwner(userId);
        allow update: if request.auth != null && (isOwner(userId) || isFellowshipMember(resource.data.fellowshipId));
      }
      
      match /joinedCampaigns/{campaignId} {
        allow read, create, delete: if isOwner(userId);
      }
      
      match /disciplineHistory/{logId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      match /bibleHighlights/{highlightId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if request.auth != null;
      }

      match /fellowships/{fellowshipId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /souls/{soulId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isFellowshipMember(resource.data.fellowshipId));
    }

    match /testimonies/{testimonyId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && ( (resource.data.authorId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['supporters'])) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']) && request.resource.data.supporters.size() == (('supporters' in resource.data) ? resource.data.supporters.size() : 0) + 1 && request.auth.uid in request.resource.data.supporters) );
    }
    
    match /prayerRequests/{requestId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && ( (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usersWhoPrayed']) && request.resource.data.usersWhoPrayed.size() == (('usersWhoPrayed' in resource.data) ? resource.data.usersWhoPrayed.size() : 0) + 1 && request.auth.uid in request.resource.data.usersWhoPrayed) || (resource.data.authorId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'answered' && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'answeredTestimonyId'])) || (resource.data.authorId == request.auth.uid && resource.data.status == 'answered' && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'answeredTestimonyId'])) );
    }

    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow delete: if false; 
      allow update: if request.auth != null && ( (request.auth.uid == resource.data.organizerId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'soulsLogged'])) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soulsLogged']) && request.resource.data.soulsLogged == (('soulsLogged' in resource.data) ? resource.data.soulsLogged : 0) + 1) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) && request.resource.data.participants == resource.data.participants + 1 && (resource.data.maxParticipants == null || request.resource.data.participants <= resource.data.maxParticipants)) );

      match /participants/{userId} {
        allow read, write: if isOwner(userId);
        allow list: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId;
      }
    }
    
    match /chats/{chatId} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; 
      }
    }

    match /accountabilityRequests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId && request.resource.data.fromUserId in request.resource.data.participantIds && request.resource.data.toUserId in request.resource.data.participantIds && request.resource.data.participantIds.size() == 2 && requestId == request.resource.data.participantIds.join('_');
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId && request.resource.data.status in ['accepted', 'declined'] && resource.data.status == 'pending';
      allow delete: if request.auth != null && ( (request.auth.uid == resource.data.fromUserId && resource.data.status == 'pending') || (resource.data.status in ['accepted', 'declined'] && request.auth.uid in resource.data.participantIds) );
    }
    
    match /fellowships/{fellowshipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.organizerId == request.auth.uid;
      allow update: if request.auth != null && ( (request.auth.uid == resource.data.organizerId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'memberCount'])) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])) || (request.resource.data.diff(resource.data).affectedKeys().hasAll(['memberIds', 'memberCount']) && request.resource.data.diff(resource.data).affectedKeys().size() == 2 && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 && request.auth.uid in request.resource.data.memberIds && !(request.auth.uid in resource.data.memberIds) && request.resource.data.memberCount == resource.data.memberCount + 1) );

      match /members/{memberId} {
        allow read, list: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null && ( request.auth.uid == memberId || request.auth.uid == get(/databases/$(database)/documents/fellowships/$(fellowshipId)).data.organizerId );
      }
    }

    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}