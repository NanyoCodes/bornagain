rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can view any profile, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Souls are private to the user who won them.
    match /users/{userId}/souls/{soulId} {
    	allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Records of joined campaigns are private to the user.
    match /users/{userId}/joinedCampaigns/{campaignId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Testimonies are public to all authenticated users, but only writable by the author.
    match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.authorId;
    }

    // Campaigns are public to all authenticated users.
    // Joining or creating a campaign is allowed for authenticated users.
    // Updates and deletes are restricted to the organizer.
    match /campaigns/{campaignId} {
    	allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Allow updates for incrementing participants
      allow delete: if request.auth != null && request.auth.uid == resource.data.organizerId;
    }
  }
}
