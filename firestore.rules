rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/update their own profile.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // Allow user creation for anyone who is authenticated.
      allow create: if request.auth != null;
    }

    // Souls are private to the user who won them.
    match /users/{userId}/souls/{soulId} {
    	allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Testimonies are public to all authenticated users, but only writable by the author.
    match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.authorId;
    }

    // Campaigns are public to all authenticated users, but only writable by the organizer.
    match /campaigns/{campaignId} {
    	allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.organizerId;
    }
  }
}
