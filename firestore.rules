rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function getRequestId(id1, id2) {
      return id1 < id2 ? id1 + '_' + id2 : id2 + '_' + id1;
    }

    function isAccountabilityPartner(ownerId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(ownerId)) &&
             request.auth.uid in get(/databases/$(database)/documents/users/$(ownerId)).data.get('partnerIds', []);
    }

    function isFellowshipMember(fellowshipId) {
      return request.auth != null && 
             fellowshipId != null && 
             fellowshipId is string && 
             fellowshipId != "" && 
             fellowshipId != "none" &&
             exists(/databases/$(database)/documents/fellowships/$(fellowshipId)) &&
             request.auth.uid in get(/databases/$(database)/documents/fellowships/$(fellowshipId)).data.get('memberIds', []);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if isOwner(userId);

      allow update: if request.auth != null && (
        isOwner(userId) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds', 'lastActive', 'firstName', 'lastName', 'fullName_lowercase', 'name_tokens', 'location', 'phone', 'photoURL', 'bio', 'defaultMeetingLink', 'monthlySoulsGoal']) && (
          exists(/databases/$(database)/documents/accountabilityRequests/$(getRequestId(userId, request.auth.uid))) ||
          (resource.data.get('partnerIds', []).size() > 0 && request.auth.uid in resource.data.partnerIds) ||
          isOwner(userId)
        ))
      );

      match /souls/{soulId} {
        allow read: if isOwner(userId) || isFellowshipMember(resource.data.get('fellowshipId', ''));
        allow create: if isOwner(userId);
        allow update: if request.auth != null && (request.auth.uid == userId || isFellowshipMember(resource.data.get('fellowshipId', '')));
      }
      
      match /joinedCampaigns/{campaignId} {
        allow read, create, delete: if isOwner(userId);
      }
      
      match /disciplineHistory/{logId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      match /bibleHighlights/{highlightId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if request.auth != null;
      }

      match /fellowships/{fellowshipId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /souls/{soulId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if request.auth != null && (resource.data.get('userId', '') == request.auth.uid || isFellowshipMember(resource.data.get('fellowshipId', '')));
    }

    match /testimonies/{testimonyId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && ( 
        (resource.data.authorId == request.auth.uid) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']) && 
         ( (request.resource.data.supporters.size() == resource.data.get('supporters', []).size() + 1 && request.auth.uid in request.resource.data.supporters) ||
           (request.resource.data.supporters.size() == resource.data.get('supporters', []).size() - 1 && !(request.auth.uid in request.resource.data.supporters))
         )) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inspiredBy']) && 
         ( (request.resource.data.inspiredBy.size() == resource.data.get('inspiredBy', []).size() + 1 && request.auth.uid in request.resource.data.inspiredBy) ||
           (request.resource.data.inspiredBy.size() == resource.data.get('inspiredBy', []).size() - 1 && !(request.auth.uid in request.resource.data.inspiredBy))
         )) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedBy']) && 
         ( (request.resource.data.connectedBy.size() == resource.data.get('connectedBy', []).size() + 1 && request.auth.uid in request.resource.data.connectedBy) ||
           (request.resource.data.connectedBy.size() == resource.data.get('connectedBy', []).size() - 1 && !(request.auth.uid in request.resource.data.connectedBy))
         ))
      );

      match /comments/{commentId} {
          allow get, list: if true;
          allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
          allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
          allow update: if request.auth != null && (
            (resource.data.authorId == request.auth.uid) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']) && 
             ( (request.resource.data.supporters.size() == resource.data.get('supporters', []).size() + 1 && request.auth.uid in request.resource.data.supporters) ||
               (request.resource.data.supporters.size() == resource.data.get('supporters', []).size() - 1 && !(request.auth.uid in request.resource.data.supporters))
             )) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inspiredBy']) && 
             ( (request.resource.data.inspiredBy.size() == resource.data.get('inspiredBy', []).size() + 1 && request.auth.uid in request.resource.data.inspiredBy) ||
               (request.resource.data.inspiredBy.size() == resource.data.get('inspiredBy', []).size() - 1 && !(request.auth.uid in request.resource.data.inspiredBy))
             )) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedBy']) && 
             ( (request.resource.data.connectedBy.size() == resource.data.get('connectedBy', []).size() + 1 && request.auth.uid in request.resource.data.connectedBy) ||
               (request.resource.data.connectedBy.size() == resource.data.get('connectedBy', []).size() - 1 && !(request.auth.uid in request.resource.data.connectedBy))
             ))
          );
      }
    }
    
    match /prayerRequests/{requestId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && ( 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usersWhoPrayed']) && 
         ( (request.resource.data.usersWhoPrayed.size() == resource.data.get('usersWhoPrayed', []).size() + 1 && request.auth.uid in request.resource.data.usersWhoPrayed) ||
           (request.resource.data.usersWhoPrayed.size() == resource.data.get('usersWhoPrayed', []).size() - 1 && !(request.auth.uid in request.resource.data.usersWhoPrayed))
         )) || 
        (resource.data.authorId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'answered' && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'answeredTestimonyId'])) || 
        (resource.data.authorId == request.auth.uid && resource.data.status == 'answered' && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'answeredTestimonyId'])) 
      );
    }

    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow delete: if false; 
      allow update: if request.auth != null && ( (request.auth.uid == resource.data.organizerId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'soulsLogged'])) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soulsLogged']) && request.resource.data.soulsLogged == (('soulsLogged' in resource.data) ? resource.data.soulsLogged : 0) + 1) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) && request.resource.data.participants == resource.data.participants + 1 && (resource.data.maxParticipants == null || request.resource.data.participants <= resource.data.maxParticipants)) );

      match /participants/{userId} {
        allow read, write: if isOwner(userId);
        allow list: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId;
      }
    }
    
    match /chats/{chatId} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        ( (exists(/databases/$(database)/documents/fellowships/$(chatId)) || exists(/databases/$(database)/documents/campaigns/$(chatId))) && 
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantIds', 'participantInfo']) &&
         request.resource.data.participantIds.size() == resource.data.get('participantIds', []).size() + 1 &&
         request.auth.uid in request.resource.data.participantIds &&
         !(request.auth.uid in resource.data.get('participantIds', [])) )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; 
      }
    }

    match /accountabilityRequests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId && request.resource.data.fromUserId in request.resource.data.participantIds && request.resource.data.toUserId in request.resource.data.participantIds && request.resource.data.participantIds.size() == 2 && requestId == getRequestId(request.resource.data.fromUserId, request.resource.data.toUserId);
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId && request.resource.data.status in ['accepted', 'declined'] && resource.data.status == 'pending';
      allow delete: if request.auth != null && request.auth.uid in resource.data.participantIds;
    }
    
    match /fellowships/{fellowshipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.organizerId == request.auth.uid;
      
      allow update: if request.auth != null && (
        // Case 1: Organizer updating group details
        (request.auth.uid == resource.data.organizerId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'memberCount'])) ||
        
        // Case 2: Standard member count update (e.g. unassigning a soul)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])) ||
        
        // Case 3: User joining the group
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'memberCount']) &&
         request.resource.data.memberIds.size() == resource.data.get('memberIds', []).size() + 1 &&
         request.auth.uid in request.resource.data.memberIds &&
         !(request.auth.uid in resource.data.get('memberIds', [])) &&
         request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1)
      );

      match /members/{memberId} {
        allow read, list: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null && ( request.auth.uid == memberId || request.auth.uid == get(/databases/$(database)/documents/fellowships/$(fellowshipId)).data.organizerId );
      }
    }

    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}