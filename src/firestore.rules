rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deployment trigger: PWA icon synchronization & maskable support - 2025-08-05T09:00:00Z
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function getRequestId(id1, id2) {
      return id1 < id2 ? id1 + '_' + id2 : id2 + '_' + id1;
    }

    function isFellowshipMember(fellowshipId) {
      return request.auth != null && 
             fellowshipId != null && 
             fellowshipId is string && 
             fellowshipId != "" && 
             fellowshipId != "none" &&
             exists(/databases/$(database)/documents/fellowships/$(fellowshipId)) &&
             request.auth.uid in get(/databases/$(database)/documents/fellowships/$(fellowshipId)).data.get('memberIds', []);
    }

    function isFellowshipOrganizer(fId) {
      return request.auth != null && 
             fId != null &&
             fId != "" &&
             exists(/databases/$(database)/documents/fellowships/$(fId)) &&
             get(/databases/$(database)/documents/fellowships/$(fId)).data.organizerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if isOwner(userId);

      allow update: if request.auth != null && (
        isOwner(userId) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds', 'lastActive', 'backgroundImage', 'backgroundOverlayOpacity', 'churchInfo', 'prayerLinks', 'notificationSettings', 'monthlySoulsGoal']) && (
          exists(/databases/$(database)/documents/accountabilityRequests/$(getRequestId(userId, request.auth.uid))) ||
          (resource.data.get('partnerIds', []).size() > 0 && request.auth.uid in resource.data.partnerIds)
        ))
      );

      match /souls/{soulId} {
        allow read: if isOwner(userId) || isFellowshipMember(resource.data.get('fellowshipId', '')) || isFellowshipMember(resource.data.get('associationId', ''));
        allow create, update, delete: if isOwner(userId);
      }
      
      match /joinedCampaigns/{campaignId} {
        allow read, create, delete: if isOwner(userId);
      }
      
      match /disciplineHistory/{logId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      match /bibleHighlights/{highlightId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if request.auth != null;
      }

      match /fellowships/{fellowshipId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /souls/{soulId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if request.auth != null && (
        (resource.data.get('userId', '') == request.auth.uid) || 
        (resource.data.userId == request.auth.uid) || 
        isFellowshipMember(resource.data.get('fellowshipId', '')) ||
        isFellowshipMember(resource.data.get('associationId', ''))
      );
    }

    match /testimonies/{testimonyId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && ( 
        (resource.data.authorId == request.auth.uid) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters', 'inspiredBy', 'connectedBy']))
      );

      match /comments/{commentId} {
          allow get, list: if true;
          allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
          allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
          allow update: if request.auth != null && (
            (resource.data.authorId == request.auth.uid) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters', 'inspiredBy', 'connectedBy']))
          );
      }
    }
    
    match /prayerRequests/{requestId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && ( 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usersWhoPrayed'])) || 
        (resource.data.authorId == request.auth.uid && request.resource.data.status in ['pending', 'answered'])
      );
    }

    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow delete: if false; 
      allow update: if request.auth != null && ( (request.auth.uid == resource.data.organizerId) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soulsLogged'])) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])) );

      match /participants/{userId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }
    }
    
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid in resource.data.get('participantIds', []);
      allow update: if request.auth != null && request.auth.uid in resource.data.get('participantIds', []);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; 
      }
    }

    match /accountabilityRequests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null && (request.auth.uid == resource.data.toUserId || request.auth.uid == request.resource.data.fromUserId);
      allow delete: if request.auth != null && request.auth.uid in resource.data.participantIds;
    }
    
    match /fellowships/{fellowshipId} {
      allow get, list: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && isFellowshipOrganizer(fellowshipId);

      match /members/{memberId} {
        allow read, list: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /devotionals/{date} {
        allow read: if true;
        allow create, delete: if request.auth != null && isFellowshipOrganizer(fellowshipId);
        allow update: if request.auth != null && (
          isFellowshipOrganizer(fellowshipId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters', 'inspiredBy', 'connectedBy'])
        );
        
        match /comments/{commentId} {
            allow get, list: if true;
            allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
            allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
            allow update: if request.auth != null && (
              (resource.data.authorId == request.auth.uid) ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters', 'inspiredBy', 'connectedBy']))
            );
        }
      }
    }

    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
