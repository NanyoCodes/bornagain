
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function arePartners(user1, user2) {
      let user1Data = get(/databases/$(database)/documents/users/$(user1)).data;
      let user2Data = get(/databases/$(database)/documents/users/$(user2)).data;
      
      return user1Data != null && 'partnerIds' in user1Data && user1Data.partnerIds is list && user2 in user1Data.partnerIds &&
             user2Data != null && 'partnerIds' in user2Data && user2Data.partnerIds is list && user1 in user2Data.partnerIds;
    }

    function isFellowshipMember(fellowshipId) {
      return request.auth != null && fellowshipId != null && 
             exists(/databases/$(database)/documents/fellowships/$(fellowshipId)) &&
             request.auth.uid in get(/databases/$(database)/documents/fellowships/$(fellowshipId)).data.memberIds;
    }

    // User profile access rules and all subcollections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if isOwner(userId);

      allow update: if request.auth != null && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountabilityPartners', 'partnerIds'])) ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds'])) ||
        (!isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountabilityPartners', 'partnerIds']))
      );

      // Subcollection Rules
      match /souls/{soulId} {
        allow read: if isOwner(userId) || isFellowshipMember(resource.data.fellowshipId);
        allow create: if isOwner(userId);
        // Allow fellowship members to update spiritual progress and logs
        allow update: if request.auth != null && (isOwner(userId) || isFellowshipMember(resource.data.fellowshipId));
      }
      
      match /joinedCampaigns/{campaignId} {
        allow read, create, delete: if isOwner(userId);
      }
      
      match /disciplineHistory/{logId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      match /bibleHighlights/{highlightId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if request.auth != null;
      }

      match /fellowships/{fellowshipId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Global souls collection
    match /souls/{soulId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isFellowshipMember(resource.data.fellowshipId));
    }

    match /testimonies/{testimonyId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.authorId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['supporters'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']) && request.auth.uid in request.resource.data.supporters)
      );
    }
    
    match /prayerRequests/{requestId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
    }

    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;

      match /participants/{userId} {
        allow read, write: if isOwner(userId);
        allow list: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId;
      }
    }
    
    match /chats/{chatId} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /accountabilityRequests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid in resource.data.participantIds);
    }
    
    match /fellowships/{fellowshipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.organizerId == request.auth.uid;
      allow update: if request.auth != null;

      match /members/{memberId} {
        allow read, list: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null;
      }
    }

    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
