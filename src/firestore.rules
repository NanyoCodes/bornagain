
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile access rules and all subcollections
    match /users/{userId} {
      // Allow any authenticated user to read user profiles
      allow read: if request.auth != null;
      
      // Allow users to write only to their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // --- Subcollection Rules ---

      // Souls are private to the user.
      match /souls/{soulId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Joined campaigns are private to the user.
      match /joinedCampaigns/{campaignId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Discipline history is only readable by the user and their accountability partner.
      match /disciplineHistory/{logId} {
        allow read: if request.auth != null && (
            request.auth.uid == userId ||
            (
                exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountabilityPartnerId == userId
            ) ||
            (
                exists(/databases/$(database)/documents/users/$(userId)) &&
                get(/databases/$(database)/documents/users/$(userId)).data.accountabilityPartnerId == request.auth.uid
            )
        );
        // Only the user can write to their own discipline history.
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Bible highlights are private to the user.
      match /bibleHighlights/{highlightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Notifications are private to the user, though others can create them.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Global souls collection for aggregation.
    match /souls/{soulId} {
      allow read: if request.auth != null;
      // Allow any authenticated user to create a document here.
      // The user's private /users/{userId}/souls collection has the stricter rule.
      allow create: if request.auth != null;
      allow update, delete: if false; // Immutable
    }

    // Testimonies are public, but only writable by the author.
    match /testimonies/{testimonyId} {
      allow get, list: if true;
      
      // Author can create, update (non-supporter fields), or delete their own testimony.
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      
      allow update: if request.auth != null && (
        // SCENARIO 1: Author can update their own testimony content, but not supporters.
        (
          resource.data.authorId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['supporters'])
        ) ||
        // SCENARIO 2: Any authenticated user can support a testimony if they are not already a supporter.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']) &&
          (resource.data.supporters == null || !(request.auth.uid in resource.data.supporters)) &&
          request.resource.data.supporters.size() == (resource.data.supporters == null ? 0 : resource.data.supporters.size()) + 1 &&
          request.auth.uid in request.resource.data.supporters
        )
      );
    }
    
    // Prayer Requests are public.
    match /prayerRequests/{requestId} {
      allow get, list: if true; // Publicly readable for the community to pray

      // Author can create their own prayer request. authorId is required.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;

      // Any authenticated user can pray for a request by adding their UID to the usersWhoPrayed list.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usersWhoPrayed']) &&
        (resource.data.usersWhoPrayed == null || !(request.auth.uid in resource.data.usersWhoPrayed)) &&
        request.resource.data.usersWhoPrayed.size() == (resource.data.usersWhoPrayed == null ? 0 : resource.data.usersWhoPrayed.size()) + 1 &&
        request.auth.uid in request.resource.data.usersWhoPrayed;

      // Author can delete their own prayer request.
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Campaigns are public to read.
    // Updates are restricted based on user role and action.
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow delete: if false; // Hard deletes are disallowed. Status is updated instead.

      allow update: if request.auth != null && (
        // SCENARIO 1: Organizer updates details (including soft delete).
        (
          request.auth.uid == resource.data.organizerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'soulsLogged'])
        ) ||
        // SCENARIO 2: A user joins a campaign.
        (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
            request.resource.data.participants == (resource.data.participants || 0) + 1
        ) ||
        // SCENARIO 3: A user logs a soul.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soulsLogged']) &&
          request.resource.data.soulsLogged == (resource.data.soulsLogged || 0) + 1
        ) ||
        // SCENARIO 4: Organizer removes a participant.
        (
          request.auth.uid == resource.data.organizerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
          request.resource.data.participants == (resource.data.participants || 0) - 1
        )
      );

      // Rules for the participants subcollection.
      match /participants/{userId} {
        // Organizer can see all participants
        allow read: if request.auth != null && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId == request.auth.uid;
        // A user can add themselves as a participant
        allow create: if request.auth != null && request.auth.uid == userId;
        // A user can remove themselves, or the organizer can remove any participant
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.organizerId == request.auth.uid
        );
        // No updates to participant docs are allowed.
        allow update: if false;
      }
    }
    
    // Chat rules
    match /chats/{chatId} {
      // User can create a chat if they are one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      // User can get/list chats they are a participant in
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // User can update a chat (e.g. last message) if they are a participant
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;

      // No one can delete a chat history
      allow delete: if false;

      match /messages/{messageId} {
        // User can read messages in a chat they are a part of
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // User can create a message if they are a participant and the sender
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        // Messages are immutable
        allow update, delete: if false; 
      }
    }

    // Accountability Requests
    match /accountabilityRequests/{requestId} {
      // Allow a user to get/list requests they are a part of.
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // Allow a user to create a request if they are the sender and both participants are in the list.
      // ID must be predictable: {uid1_uid2}
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUserId
                    && request.resource.data.fromUserId in request.resource.data.participantIds
                    && request.resource.data.toUserId in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2
                    && requestId == request.resource.data.participantIds.join('_');

      // Recipient can accept/decline a pending request
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId
                  && request.resource.data.status in ['accepted', 'declined']
                  && resource.data.status == 'pending';
                  
      // Sender can cancel a pending request. Either party can delete an accepted/declined request.
      allow delete: if request.auth != null && (
          (request.auth.uid == resource.data.fromUserId && resource.data.status == 'pending') ||
          (resource.data.status in ['accepted', 'declined'] && request.auth.uid in resource.data.participantIds)
      );
    }

    // Trigger Email extension collection
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
